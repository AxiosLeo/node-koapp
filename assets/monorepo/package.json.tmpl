{
  "name": "${name}",
  "version": "0.0.0",
  "private": true,
  "description": "${name} monorepo managed by pnpm workspaces",
  "bin": {
    "${name}": "./bin/${name}.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter ${name}-services run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@axiosleo/cli-tool": "^2.0.0",
    "@axiosleo/koapp": "^2.0.0",
    "axios": "^1.21.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10"
  }
}
