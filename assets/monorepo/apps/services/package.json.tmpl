{
  "name": "${name}-services",
  "version": "0.0.1",
  "description": "",
  "main": "dist/bootstrap.js",
  "bin": {
    "bootstrap": "dist/bootstrap.js"
  },
  "scripts": {
    "lint": "eslint --fix src/",
    "build": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "start": "DEPLOY_ENV=prod && npm run build && node ./dist/bootstrap.js",
    "dev": "nodemon",
    "test": "mocha -r @swc-node/register 'src/**/*.test.ts'",
    "test-one": "NODE_ENV=test mocha -r @swc-node/register --exit",
    "test-cov": "nyc mocha -r @swc-node/register 'src/**/*.test.ts' --parallel"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@axiosleo/koapp": "^2.0.0",
    "better-sqlite3": "^13.2.0",
    "cluster": "^0.7.7",
    "dotenv": "^18.0.10",
    "validatorjs": "^3.22.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/better-sqlite3": "^9.6.0",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-static-server": "^1.5.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/validatorjs": "^3.15.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "json-schema-to-ts": "^3.1.1",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3"
  },
  "pkg": {
    "scripts": "dist/bootstrap.js",
    "targets": [
      "linux-x64"
    ],
    "outputPath": "dist",
    "assets": "assets/**/*"
  }
}
