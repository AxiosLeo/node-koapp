{
  "name": "@axiosleo/koapp",
  "version": "2.0.0",
  "description": "",
  "author": "AxiosLeo",
  "bin": {
    "koapp": "bin/koapp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxiosLeo/node-koapp.git"
  },
  "scripts": {
    "dev": "nodemon",
    "lint": "tsc --noEmit --types node --skipDefaultLibCheck ./index.d.ts && eslint --fix src/",
    "test": "mocha --reporter spec --timeout 3000 tests/*.tests.js",
    "test-cov": "nyc -r=lcov -r=html -r=text -r=json mocha -t 10000 -R spec tests/*.tests.js",
    "ci": "npm run lint && npm run test-cov",
    "clear": "rm -rf ./.nyc_output ./coverage ./.uploads/ ./node_modules ./package-lock.json ./pnpm-lock.yaml"
  },
  "directories": {
    "lib": "src"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@axiosleo/cli-tool": "^2.0.0",
    "koa": "^3.3.0",
    "koa-bodyparser": "^4.4.1",
    "koa-session": "^7.0.2",
    "koa-static-server": "^1.5.2",
    "multer": "^2.5.0",
    "uuid": "^14.0.3",
    "validatorjs": "^3.22.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@koa/multer": "^4.0.0",
    "@types/big.js": "^7.0.0",
    "@types/koa": "^3.0.3",
    "@types/koa-static-server": "^1.5.3",
    "@types/koa__multer": "^2.0.7",
    "@types/node": "^26.6.6",
    "@types/validatorjs": "^3.15.5",
    "@types/ws": "^8.18.2",
    "chai": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "typescript": "^7.0.2"
  }
}
